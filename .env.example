# apps/api
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/erp_saas_dev?schema=public"
# Role RLS non-superuser/non-bypassrls (docs/adr/0008-...) — utilisé pour toute
# requête exécutée dans un contexte tenant déjà authentifié.
TENANT_DATABASE_URL="postgresql://erp_app_tenant:change-me@localhost:5432/erp_saas_dev?schema=public"
JWT_ACCESS_SECRET="change-me-min-32-chars-random-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
MFA_ENCRYPTION_KEY="change-me-min-32-chars-random-value"
PORT=3000

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:3000"
