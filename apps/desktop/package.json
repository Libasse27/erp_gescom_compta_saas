{
  "name": "@erp/desktop",
  "private": true,
  "version": "0.0.1",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron dist/main.js",
    "build": "tsc -p tsconfig.json",
    "package": "pnpm build && electron-builder",
    "lint": "eslint electron",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:tenant": "echo \"pas de tenant côté desktop — le process principal Electron ne touche jamais aux données métier, tout passe par apps/web\" && exit 0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "sn.erp-gescom-compta.desktop",
    "productName": "ERP Gescom Compta",
    "files": ["dist/**/*"],
    "directories": {
      "output": "release"
    }
  }
}
