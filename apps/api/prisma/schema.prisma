// Schéma de domaine SaaS — Phase 1 (docs/PROMPT-MAITRE-SAAS.md), complété par
// les modules ERP au fil de la Phase 8 (un modèle par module migré).
//
// Isolation tenant : toute table tenant porte enterpriseId, indexé, avec une
// policy Row Level Security PostgreSQL correspondante (docs/adr/0002-...).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_INVITE
  ACTIVE
  SUSPENDED
}

enum EnterpriseStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Distinct de EnterpriseStatus : une entreprise ACTIVE peut avoir un
// abonnement PAST_DUE (docs/PROMPT-MAITRE-SAAS.md, Phase 1).
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  STRIPE
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum SettingScope {
  PLATFORM
  ENTERPRISE
}

enum NotificationType {
  WELCOME
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  NEW_USER
  USER_INVITATION
  ENTERPRISE_SUSPENDED
  PLAN_CHANGED
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  CHANGE_ROLE
  CREATE_INVOICE
  UPDATE_PRODUCT
  DELETE_CLIENT
  CREATE_CUSTOMER
  UPDATE_CUSTOMER
  CREATE_SUPPLIER
  UPDATE_SUPPLIER
  DELETE_SUPPLIER
  CREATE_PRODUCT
  DELETE_PRODUCT
  CREATE_STOCK_MOVEMENT
  CREATE_SALE
  CONFIRM_SALE
  CANCEL_SALE
  CREATE_PURCHASE
  CONFIRM_PURCHASE
  CANCEL_PURCHASE
  MARK_INVOICE_PAID
  VOID_INVOICE
  CREATE_ACCOUNT
  UPDATE_ACCOUNT
  CREATE_JOURNAL_ENTRY
  CHANGE_PLAN
  PAYMENT
  SUSPEND_ACCOUNT
  REACTIVATE_ACCOUNT
  EXPORT_DATA
  CROSS_TENANT_ACCESS
  ACCOUNT_LOCKED
  REFRESH_TOKEN_REUSE_DETECTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  MFA_ENABLED
  MFA_CHALLENGE_FAILED
  USER_INVITED
  INVITATION_ACCEPTED
  ENTERPRISE_PROVISIONED
  // Corrige SEC-03 (docs/audit/SECURITY-AUDIT.md) : refresh rejeté car
  // User.status ou Enterprise.status n'est plus ACTIVE.
  REFRESH_REJECTED_INACTIVE_ACCOUNT
  // Corrige BIL-03 (docs/audit/BILLING-AUDIT.md) : transitions automatiques
  // du cycle de vie de l'abonnement (SubscriptionLifecycleService), pas une
  // action d'un utilisateur — distinctes de SUSPEND_ACCOUNT/REACTIVATE_ACCOUNT
  // (BIL-04, Enterprise.status, déclenché par un Super Admin).
  EXPIRE_TRIAL
  SUSPEND_SUBSCRIPTION
  // Corrige BIL-09 (docs/audit/BILLING-AUDIT.md) : chaque rejet de webhook
  // de paiement (signature/timestamp invalide, corps malformé, référence
  // inconnue, montant divergent, paiement sans abonnement, transition de
  // statut invalide) devient détectable — jusqu'ici silencieux au-delà de
  // la ligne HTTP générique.
  PAYMENT_WEBHOOK_REJECTED
  // Corrige BIL-12 (docs/audit/BILLING-AUDIT.md) : édition du catalogue
  // plateforme (plans/features/limites) par le Super Admin — distinctes de
  // CHANGE_PLAN (une entreprise change d'abonnement vers un plan existant).
  CREATE_PLAN
  UPDATE_PLAN
  UPDATE_PLAN_FEATURE
  UPDATE_PLAN_LIMIT
}

// ACTIVE : jamais utilisé. ROTATED : échangé contre un nouveau token (rotation
// normale). REVOKED : famille entière invalidée (logout, ou réutilisation
// détectée — CLAUDE.md §6). Présenter un token ROTATED ou REVOKED déclenche
// la révocation de toute la famille.
enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

// Une seule table pour trois usages proches (évite 3 tables quasi
// identiques) : vérification email, réinitialisation mot de passe,
// invitation utilisateur.
enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
}

// ─────────────────────────────────────────────────────────────────────────
// Identité — User / Enterprise
// ─────────────────────────────────────────────────────────────────────────

// isSuperAdmin = true <=> enterpriseId IS NULL : invariant posé en CHECK
// constraint SQL dans la migration (non exprimable dans le DSL Prisma),
// voir docs/adr/0004-modele-identite.md. Jamais modifiable via une route API.
model User {
  id               String      @id @default(uuid()) @db.Uuid
  email            String      @unique
  passwordHash     String      @map("password_hash")
  firstName        String      @map("first_name")
  lastName         String      @map("last_name")
  phone            String?
  enterpriseId     String?     @map("enterprise_id") @db.Uuid
  enterprise       Enterprise? @relation(fields: [enterpriseId], references: [id])
  isSuperAdmin     Boolean     @default(false) @map("is_super_admin")
  status           UserStatus  @default(PENDING_INVITE)
  mfaEnabled       Boolean     @default(false) @map("mfa_enabled")
  mfaSecret        String?     @map("mfa_secret")
  emailVerifiedAt  DateTime?   @map("email_verified_at")
  failedLoginCount Int         @default(0) @map("failed_login_count")
  lockedUntil      DateTime?   @map("locked_until")
  lastLoginAt      DateTime?   @map("last_login_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  userRoles     UserRole[]
  auditLogs     AuditLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]

  @@index([enterpriseId])
  @@map("users")
}

// Rotation avec détection de réutilisation (CLAUDE.md §6) : à chaque refresh,
// le token présenté passe ACTIVE → ROTATED et un nouveau token ACTIVE est
// créé dans la même familyId. Si un token ROTATED ou REVOKED est présenté à
// nouveau, c'est un signe de vol : toute la famille (familyId) est révoquée.
model RefreshToken {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId          String             @map("family_id") @db.Uuid
  tokenHash         String             @unique @map("token_hash")
  status            RefreshTokenStatus @default(ACTIVE)
  expiresAt         DateTime           @map("expires_at")
  replacedByTokenId String?            @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  revokedAt         DateTime?          @map("revoked_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Jetons à usage unique (vérification email, reset password, invitation).
// tokenHash uniquement : le token en clair n'est jamais persisté, seul son
// hash l'est (comme un mot de passe), pour qu'une fuite de la base ne
// permette pas de rejouer un lien de reset/invitation.
model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("auth_tokens")
}

model Enterprise {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  legalName             String?          @map("legal_name")
  ninea                 String?
  rccm                  String?
  address               String?
  city                  String?
  country               String           @default("SN")
  phone                 String?
  email                 String?
  currency              String           @default("XOF")
  sector                String?
  status                EnterpriseStatus @default(ACTIVE)
  currentSubscriptionId String?          @unique @map("current_subscription_id") @db.Uuid
  currentSubscription   Subscription?    @relation("EnterpriseCurrentSubscription", fields: [currentSubscriptionId], references: [id])
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  users         User[]
  roles         Role[]
  subscriptions Subscription[] @relation("EnterpriseSubscriptions")
  payments      Payment[]
  invoices      Invoice[]
  auditLogs      AuditLog[]
  settings       Setting[]
  notifications  Notification[]
  invoiceCounter InvoiceCounter?
  accounts       Account[]
  onboardingState OnboardingState?
  customers       Customer[]
  suppliers       Supplier[]
  products        Product[]
  stockMovements  StockMovement[]
  sales           Sale[]
  saleLines       SaleLine[]
  purchases       Purchase[]
  purchaseLines   PurchaseLine[]
  salesInvoices       SalesInvoice[]
  salesInvoiceCounter SalesInvoiceCounter?
  journalEntries       JournalEntry[]
  journalEntryLines    JournalEntryLine[]
  journalEntryCounter  JournalEntryCounter?

  // NINEA/RCCM uniques par pays, nullables (non exigés à l'inscription,
  // voir docs/SPECIFICATIONS-SAAS.md §7 étape 2 — seul "Nom entreprise" est requis).
  @@unique([ninea, country])
  @@unique([rccm, country])
  @@map("enterprises")
}

// ─────────────────────────────────────────────────────────────────────────
// RBAC — Role / Permission / UserRole (docs/SPECIFICATIONS-SAAS.md §12)
// ─────────────────────────────────────────────────────────────────────────

// Un Role appartient toujours à une Enterprise (les 7 rôles par défaut sont
// seedés par entreprise en Phase 6, puis librement renommés/modifiés).
// Il n'y a pas de "rôle SUPER_ADMIN" ici : le Super Admin est identifié par
// User.isSuperAdmin, pas par le système RBAC tenant.
model Role {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  name         String
  isSystem     Boolean    @default(false) @map("is_system")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([enterpriseId, name])
  @@index([enterpriseId])
  @@map("roles")
}

// Catalogue plateforme, partagé par tous les tenants (ex: "clients.read").
// Source de vérité dupliquée dans packages/permissions (Phase 2) pour le
// typage compile-time des guards ; cette table est l'autorité runtime.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────────────────
// Comptabilité (Phase 8, module 8)
// ─────────────────────────────────────────────────────────────────────────

// Les 8 classes racines SYSCOHADA sont initialisées au provisioning
// (Phase 6, syscohada-chart-of-accounts.ts) ; l'ADMIN/COMPTABLE crée ensuite
// ses propres sous-comptes (ex: "601000") avec ce même modèle — pas de
// distinction racine/sous-compte en base (pas de parentId) : la classe d'un
// compte est son premier chiffre, convention SYSCOHADA déjà appliquée par
// le format de `code` (validé par packages/validation), pas une hiérarchie
// mécanique séparée qu'aucun besoin exprimé ne justifie encore. `code` est
// immuable une fois créé (les écritures le référencent) : seul `label` est
// modifiable (accounting.update).
model Account {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  code         String
  label        String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  journalEntryLines JournalEntryLine[]

  @@unique([enterpriseId, code])
  @@index([enterpriseId])
  @@map("accounts")
}

// Écriture comptable : append-only, comme StockMovement (voir
// stock.repository.ts, "grand livre") — aucune route update/delete, une
// correction se fait par une nouvelle écriture de contre-passation, jamais
// en réécrivant l'historique. Pas de statut DRAFT/POSTED dans ce cycle :
// une écriture créée est immédiatement définitive (JournalRepository.create
// vérifie l'équilibre débit=crédit avant insertion, jamais après).
// entryDate distinct de createdAt : la date comptable (ex: écriture de
// clôture saisie a posteriori) n'est pas forcément la date de saisie.
model JournalEntry {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])

  // Formatée à la création (ex: "ECR-<8 premiers caractères enterpriseId>-000123"),
  // séquence dédiée (JournalEntryCounter) — même patron que
  // SalesInvoiceCounter (module Facturation), un domaine de numérotation
  // légale de plus, indépendant des deux autres.
  number      String   @unique
  entryDate   DateTime @default(now()) @map("entry_date")
  reference   String?
  description String

  // Corrige MOBILE AUDIT-001/ERP-001 (docs/adr/0019-...) — même patron que
  // Sale.idempotencyKey.
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines JournalEntryLine[]

  @@unique([enterpriseId, idempotencyKey])
  @@index([enterpriseId])
  @@index([enterpriseId, entryDate])
  @@map("journal_entries")
}

// enterpriseId dupliqué depuis JournalEntry (pas seulement via la jointure
// journalEntryId) : une policy RLS ne peut pas traverser une relation, même
// contrainte que SaleLine/PurchaseLine. debitAmount/creditAmount : exactement
// un des deux est non nul par ligne (validé côté packages/validation, pas en
// contrainte SQL — même choix que la garde stock négatif de StockRepository,
// une règle métier vérifiée applicativement). Aucun total stocké sur
// JournalEntry : la balance d'un compte se calcule à la lecture en sommant
// ses lignes (voir AccountingModule, trial-balance) — jamais une donnée
// dérivée stockée, même principe que StockLevel.quantityOnHand.
model JournalEntryLine {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  accountId    String     @map("account_id") @db.Uuid
  account      Account    @relation(fields: [accountId], references: [id])

  label         String?
  debitAmount   Int      @default(0) @map("debit_amount")
  creditAmount  Int      @default(0) @map("credit_amount")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([enterpriseId])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// Compteur atomique par entreprise, même patron que SalesInvoiceCounter/
// InvoiceCounter : incrémenté via `INSERT ... ON CONFLICT ... RETURNING`
// dans la même transaction que la création de JournalEntry.
model JournalEntryCounter {
  enterpriseId String     @id @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  lastNumber   Int        @default(0) @map("last_number")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("journal_entry_counters")
}

// ─────────────────────────────────────────────────────────────────────────
// Module ERP — Clients / Fournisseurs / Produits (Phase 8, modules 1 à 3)
// ─────────────────────────────────────────────────────────────────────────

// Suppression toujours logique (isActive=false) : les futurs modules Ventes
// et Facturation référenceront customerId en FK, une suppression physique
// casserait leur historique (docs/PROMPT-MAITRE-SAAS.md Phase 8).
// NINEA/RCCM : format validé côté packages/validation, pas d'unicité DB
// (un même NINEA peut apparaître côté client d'un tenant et fournisseur
// d'un autre, ou légitimement en double sur des tenants indépendants).
model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  enterpriseId String       @map("enterprise_id") @db.Uuid
  enterprise   Enterprise   @relation(fields: [enterpriseId], references: [id])

  type         CustomerType @default(COMPANY)
  name         String
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String       @default("Sénégal")
  ninea        String?
  rccm         String?
  notes        String?
  isActive     Boolean      @default(true) @map("is_active")

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  sales Sale[]

  @@index([enterpriseId])
  @@index([enterpriseId, isActive])
  @@map("customers")
}

// Copie conforme de Customer (module 2 de la Phase 8) : même besoins,
// mêmes garanties (RLS, suppression logique). Réutilise CustomerType
// (INDIVIDUAL/COMPANY) — un fournisseur individuel/entreprise est le même
// concept que pour un client, dupliquer l'enum créerait deux sources de
// vérité pour la même distinction.
model Supplier {
  id           String       @id @default(uuid()) @db.Uuid
  enterpriseId String       @map("enterprise_id") @db.Uuid
  enterprise   Enterprise   @relation(fields: [enterpriseId], references: [id])

  type         CustomerType @default(COMPANY)
  name         String
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String       @default("Sénégal")
  ninea        String?
  rccm         String?
  notes        String?
  isActive     Boolean      @default(true) @map("is_active")

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  purchases Purchase[]

  @@index([enterpriseId])
  @@index([enterpriseId, isActive])
  @@map("suppliers")
}

// Module 3 de la Phase 8 : un produit n'est pas un tiers (contrairement à
// Customer/Supplier), c'est un article de catalogue avec un prix — modèle
// de champs différent, pas une copie.
// - code obligatoire et unique PAR TENANT (@@unique([enterpriseId, code])) :
//   contrairement à NINEA/RCCM sur Client/Fournisseur, un produit a toujours
//   besoin d'un identifiant court et stable.
// - Prix stocké HT (sellingPriceExcludingTax) + taux de TVA en points de
//   base (vatRateBasisPoints, 1800 = 18 %) — même patron que
//   Invoice.vatRateBasisPoints ; le TTC est calculé à l'affichage, jamais
//   stocké (évite la dérive de données). Jamais de flottant (CLAUDE.md §7).
// - Pas de purchasePrice (coût d'achat) dans ce cycle : aucun module
//   Achats/Stock n'existe encore pour l'utiliser.
// - trackStock distingue un produit physique (suivi de stock, module Stock
//   à venir) d'un service/produit non stocké — posé dès maintenant pour
//   éviter une migration rétrospective sur tous les produits déjà créés.
model Product {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])

  code                     String
  name                     String
  description              String?
  unit                     String  @default("pièce")
  category                 String?
  barcode                  String?
  sellingPriceExcludingTax Int     @map("selling_price_excluding_tax")
  vatRateBasisPoints       Int     @default(1800) @map("vat_rate_basis_points")
  trackStock               Boolean @default(true) @map("track_stock")
  isActive                 Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockMovements StockMovement[]
  saleLines      SaleLine[]
  purchaseLines  PurchaseLine[]

  @@unique([enterpriseId, code])
  @@index([enterpriseId])
  @@index([enterpriseId, isActive])
  @@map("products")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

// Module 4 de la Phase 8 : contrairement à Customer/Supplier/Product (des
// fiches), Stock n'est pas une entité mais un grand livre de mouvements —
// pas de copie du gabarit précédent sur ce point. Aucune quantité en stock
// n'est stockée sur Product : elle se calcule par agrégation des mouvements
// (même principe que le TTC produit, §5quater — jamais de donnée dérivée
// stockée, CLAUDE.md §7). StockMovement est donc la seule source de vérité,
// append-only comme AuditLog : aucune route PATCH/DELETE, une correction se
// fait via un nouveau mouvement ADJUSTMENT plutôt qu'en réécrivant
// l'historique.
// - quantity : magnitude positive pour IN/OUT (le signe est porté par
//   `type`, pas par la valeur — reste lisible dans l'historique) ; delta
//   signé (+/-, jamais 0) pour ADJUSTMENT, qui corrige un écart d'inventaire
//   dans un sens ou l'autre.
// - Pas de userId ici : AuditLog (action CREATE_STOCK_MOVEMENT) trace déjà
//   l'auteur, inutile de le dupliquer sur un modèle métier.
// - Pas de warehouseId : un seul stock implicite par entreprise dans ce
//   cycle, aucun besoin multi-entrepôt exprimé (CLAUDE.md §9, pas de
//   conception pour un besoin hypothétique) — à ajouter par migration si
//   nécessaire plus tard.
model StockMovement {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  productId    String     @map("product_id") @db.Uuid
  product      Product    @relation(fields: [productId], references: [id])

  type     StockMovementType
  quantity Int
  note     String?

  // Corrige ERP-AUDIT-001 (docs/audit/ERP-AUDIT.md, docs/adr/0019-...) —
  // même patron que Sale.idempotencyKey. POST /stock/movements est une
  // création pure (comme POST /sales), pas une transition d'état protégée
  // par une machine à états — un rejeu réseau y créerait un second
  // mouvement pour un seul événement logique.
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([enterpriseId, idempotencyKey])
  @@index([enterpriseId, productId])
  @@index([enterpriseId, createdAt])
  @@map("stock_movements")
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// Module 5 de la Phase 8 : première entité ERP à lignes (Sale + SaleLine),
// pas une copie des modules précédents. Sale n'est pas une facture — la
// Facturation (module ultérieur, distinct) transformera une vente confirmée
// en document légal ; ne pas anticiper son schéma ici.
// - Cycle de vie volontairement minimal : DRAFT -> CONFIRMED | CANCELLED.
//   CONFIRMED est terminal dans ce cycle (pas de retour en arrière qui
//   réajusterait le stock déjà sorti) : une correction après confirmation
//   passera par un futur avoir/retour, hors scope. CANCELLED n'est
//   atteignable que depuis DRAFT (aucun impact stock, rien n'a encore été
//   décrémenté).
// - Aucun total stocké (totalExcludingTax/Vat/IncludingTax) : calculé à la
//   lecture à partir des lignes, même principe que la quantité en stock
//   (StockMovement) et le TTC produit — jamais de donnée dérivée stockée.
model Sale {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  customerId   String     @map("customer_id") @db.Uuid
  customer     Customer   @relation(fields: [customerId], references: [id])

  status      SaleStatus @default(DRAFT)
  saleDate    DateTime   @default(now()) @map("sale_date")
  notes       String?
  confirmedAt DateTime?  @map("confirmed_at")
  cancelledAt DateTime?  @map("cancelled_at")

  // Corrige MOBILE AUDIT-001/ERP-001 (docs/adr/0019-...) : clé de
  // déduplication fournie par l'appelant (en-tête Idempotency-Key), jamais
  // un identifiant métier. Nullable : une création sans clé (ex. apps/web)
  // n'est jamais bloquée par des NULL répétés — Postgres ne considère
  // jamais deux NULL comme égaux dans une contrainte UNIQUE.
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines   SaleLine[]
  invoice SalesInvoice?

  @@unique([enterpriseId, idempotencyKey])
  @@index([enterpriseId])
  @@index([enterpriseId, status])
  @@map("sales")
}

// enterpriseId dupliqué depuis Sale (pas seulement via la jointure saleId) :
// une policy RLS ne peut pas traverser une relation, chaque table tenant a
// besoin de sa propre colonne — même contrainte que StockMovement.
// unitPriceExcludingTax/vatRateBasisPoints sont un instantané au moment de
// la vente, résolu côté serveur depuis Product (jamais transmis par le
// client — CLAUDE.md §6, ne jamais faire confiance à une valeur monétaire
// venue du client) : le prix catalogue peut changer ensuite sans altérer
// l'historique des ventes déjà créées. Pas de remise/prix personnalisé dans
// ce cycle. Lignes immuables après création (pas de route d'édition) :
// une vente erronée se corrige en l'annulant puis en recréant, pas en
// réécrivant ses lignes.
model SaleLine {
  id     String @id @default(uuid()) @db.Uuid
  saleId String @map("sale_id") @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  productId    String     @map("product_id") @db.Uuid
  product      Product    @relation(fields: [productId], references: [id])

  quantity              Int
  unitPriceExcludingTax Int @map("unit_price_excluding_tax")
  vatRateBasisPoints    Int @map("vat_rate_basis_points")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([enterpriseId])
  @@index([saleId])
  @@map("sale_lines")
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// Module 6 de la Phase 8 : miroir structurel de Sale (même cycle de vie
// DRAFT -> CONFIRMED | CANCELLED, CONFIRMED terminal, mêmes garanties RLS),
// mais l'effet stock est inversé — confirm() incrémente le stock (mouvement
// IN) au lieu de le décrémenter, voir PurchasesRepository.confirm. Pas de
// facture fournisseur dans ce cycle, comme Sale n'anticipe pas la
// Facturation client.
// Aucun total stocké : calculé à la lecture à partir des lignes, même
// principe que Sale.
model Purchase {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  supplierId   String     @map("supplier_id") @db.Uuid
  supplier     Supplier   @relation(fields: [supplierId], references: [id])

  status       PurchaseStatus @default(DRAFT)
  purchaseDate DateTime       @default(now()) @map("purchase_date")
  notes        String?
  confirmedAt  DateTime?      @map("confirmed_at")
  cancelledAt  DateTime?      @map("cancelled_at")

  // Corrige MOBILE AUDIT-001/ERP-001 (docs/adr/0019-...) — même patron que
  // Sale.idempotencyKey.
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines PurchaseLine[]

  @@unique([enterpriseId, idempotencyKey])
  @@index([enterpriseId])
  @@index([enterpriseId, status])
  @@map("purchases")
}

// enterpriseId dupliqué depuis Purchase, même contrainte RLS que SaleLine.
// unitCostExcludingTax est saisi par l'utilisateur à la création (contrairement
// à SaleLine.unitPriceExcludingTax) : Product ne porte pas de prix d'achat
// catalogue (voir schema.prisma, model Product — "Pas de purchasePrice dans
// ce cycle"), le coût négocié varie légitimement par fournisseur/commande,
// ce n'est pas une donnée qu'il faudrait protéger d'une falsification client
// comme un prix de vente (CLAUDE.md §6 vise les données qui affectent
// d'autres tenants ou la plateforme, pas le coût d'achat interne d'un
// tenant sur ses propres données). vatRateBasisPoints reste résolu côté
// serveur depuis Product, comme SaleLine : c'est un attribut catalogue, pas
// négocié. Lignes immuables après création, comme SaleLine.
model PurchaseLine {
  id         String   @id @default(uuid()) @db.Uuid
  purchaseId String   @map("purchase_id") @db.Uuid
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  productId    String     @map("product_id") @db.Uuid
  product      Product    @relation(fields: [productId], references: [id])

  quantity              Int
  unitCostExcludingTax  Int @map("unit_cost_excluding_tax")
  vatRateBasisPoints    Int @map("vat_rate_basis_points")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([enterpriseId])
  @@index([purchaseId])
  @@map("purchase_lines")
}

// Module 7 de la Phase 8 : transforme une Sale CONFIRMED en document légal
// (voir schema.prisma, model Sale — "la Facturation transformera une vente
// confirmée en document légal"). Une facture par vente (saleId unique) :
// pas de facturation partielle/multiple dans ce cycle. Pas de lignes propres
// (SalesInvoiceLine) : Sale.lines est déjà un instantané immuable une fois
// CONFIRMED, la dupliquer ici créerait une seconde source de vérité pour la
// même donnée — la vue de lecture recompose les lignes depuis la vente liée
// (voir InvoicingRepository.toInvoiceView).
// Réutilise l'enum InvoiceStatus (déjà défini pour la facturation SaaS
// plateforme, model Invoice) plutôt que d'en dupliquer un identique : DRAFT
// n'est jamais utilisé par ce module (une facture est émise directement à la
// création, jamais éditée avant), ISSUED est l'état initial.
model SalesInvoice {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  saleId       String     @unique @map("sale_id") @db.Uuid
  sale         Sale       @relation(fields: [saleId], references: [id])

  // Formatée à l'émission (ex: "FACT-<8 premiers caractères enterpriseId>-000123"),
  // construite à partir de SalesInvoiceCounter — séquence dédiée à ce module,
  // distincte d'InvoiceCounter (facturation SaaS plateforme, Phase 5) : deux
  // domaines de numérotation légale indépendants ne doivent jamais partager
  // un compteur.
  number        String        @unique
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  paidAt        DateTime?     @map("paid_at")
  voidedAt      DateTime?     @map("voided_at")
  // Instantané au moment de l'émission (identité légale de l'entreprise
  // émettrice + du client) : une correction ultérieure du NINEA de
  // l'entreprise ou du client ne doit jamais altérer une facture déjà émise.
  legalMentions String        @map("legal_mentions")

  // Corrige MOBILE AUDIT-001/ERP-001 (docs/adr/0019-...) — même patron que
  // Sale.idempotencyKey. Distinct de la contrainte @unique sur saleId : deux
  // protections indépendantes (une facture par vente ; un rejeu par clé).
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([enterpriseId, idempotencyKey])
  @@index([enterpriseId])
  @@index([enterpriseId, status])
  @@map("sales_invoices")
}

// Compteur atomique par entreprise, même patron qu'InvoiceCounter
// (apps/api/src/payments/invoice-generation.service.ts) : incrémenté via
// `INSERT ... ON CONFLICT (enterprise_id) DO UPDATE ... RETURNING` dans la
// même transaction que la création de SalesInvoice.
model SalesInvoiceCounter {
  enterpriseId String     @id @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  lastNumber   Int        @default(0) @map("last_number")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("sales_invoice_counters")
}

// ─────────────────────────────────────────────────────────────────────────
// Plans, Features, Limites (docs/SPECIFICATIONS-SAAS.md §8, §21)
// ─────────────────────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  description  String?
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int?     @map("price_yearly")
  trialDays    Int      @default(0) @map("trial_days")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  planFeatures  PlanFeature[]
  planLimits    PlanLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

// Catalogue de features booléennes, plateforme. Corrige BIL-12
// (docs/audit/BILLING-AUDIT.md, docs/adr/0005-stockage-entitlements.md) :
// l'association à un plan (PlanFeature.enabled) est éditable par le Super
// Admin via PUT /admin/plans/:id/features/:featureKey
// (PlansAdminController) — jamais codée en dur côté frontend ni backend.
// Le catalogue des CLÉS elles-mêmes (quelles features existent) reste en
// revanche défini par le code + prisma/seed.ts, jamais créé dynamiquement
// par cette route (même raisonnement que le catalogue `Permission`).
model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  planId    String  @map("plan_id") @db.Uuid
  featureId String  @map("feature_id") @db.Uuid
  enabled   Boolean @default(false)
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

// Catalogue de limites chiffrées (quotas). Même logique que Feature.
model Limit {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  planLimits PlanLimit[]

  @@map("limits")
}

// value = NULL signifie "illimité".
model PlanLimit {
  planId  String @map("plan_id") @db.Uuid
  limitId String @map("limit_id") @db.Uuid
  value   Int?
  plan    Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  limit   Limit  @relation(fields: [limitId], references: [id], onDelete: Cascade)

  @@id([planId, limitId])
  @@map("plan_limits")
}

// ─────────────────────────────────────────────────────────────────────────
// Abonnement (docs/SPECIFICATIONS-SAAS.md §9, docs/PROMPT-MAITRE-SAAS.md Phase 1)
// ─────────────────────────────────────────────────────────────────────────

// Historique complet : une Enterprise a plusieurs Subscription au fil du
// temps (renouvellements, changements de plan) ; Enterprise.currentSubscription
// pointe vers celle en cours. Les transitions de statut sont validées par la
// machine à états de apps/api/src/subscriptions/subscription-state-machine.ts
// (packages/types en expose le contrat).
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  enterpriseId       String             @map("enterprise_id") @db.Uuid
  enterprise         Enterprise         @relation("EnterpriseSubscriptions", fields: [enterpriseId], references: [id])
  planId             String             @map("plan_id") @db.Uuid
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIAL)
  startDate          DateTime           @map("start_date")
  endDate            DateTime?          @map("end_date")
  trialEndDate       DateTime?          @map("trial_end_date")
  renewalDate        DateTime?          @map("renewal_date")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  events               SubscriptionEvent[]
  payments             Payment[]
  invoices             Invoice[]
  currentForEnterprise Enterprise?         @relation("EnterpriseCurrentSubscription")

  @@index([enterpriseId])
  @@map("subscriptions")
}

// Log immuable (append-only) de chaque transition de statut ou changement de
// plan — la facturation passée n'est jamais réécrite (docs/PROMPT-MAITRE-SAAS.md
// Phase 1, point de vigilance SubscriptionHistory).
model SubscriptionEvent {
  id                String              @id @default(uuid()) @db.Uuid
  subscriptionId    String              @map("subscription_id") @db.Uuid
  subscription      Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus        SubscriptionStatus? @map("from_status")
  toStatus          SubscriptionStatus  @map("to_status")
  fromPlanId        String?             @map("from_plan_id") @db.Uuid
  toPlanId          String?             @map("to_plan_id") @db.Uuid
  reason            String?
  triggeredByUserId String?             @map("triggered_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@map("subscription_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Paiement et facturation SaaS — l'entreprise paie la plateforme.
// À ne pas confondre avec les factures que l'entreprise émet à SES clients
// (module ERP "Facturation", tenant-scoped, Phase 8).
// ─────────────────────────────────────────────────────────────────────────

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  enterpriseId      String          @map("enterprise_id") @db.Uuid
  enterprise        Enterprise      @relation(fields: [enterpriseId], references: [id])
  subscriptionId    String?         @map("subscription_id") @db.Uuid
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])
  invoiceId         String?         @map("invoice_id") @db.Uuid
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])
  // Côté inverse de Invoice.paymentId (BIL-02) — pas de colonne FK ici, la
  // clé étrangère vit sur Invoice.
  invoiceGeneratedFor Invoice?      @relation("InvoicePayment")
  provider          PaymentProvider
  providerReference String?         @map("provider_reference")
  amount            Int
  currency          String          @default("XOF")
  status            PaymentStatus   @default(PENDING)
  paidAt            DateTime?       @map("paid_at")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Idempotence webhook (Phase 5) : une référence donnée chez un fournisseur
  // ne peut créer qu'un seul paiement.
  @@unique([provider, providerReference])
  @@index([enterpriseId])
  @@index([invoiceId])
  @@map("payments")
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  enterpriseId       String        @map("enterprise_id") @db.Uuid
  enterprise         Enterprise    @relation(fields: [enterpriseId], references: [id])
  subscriptionId     String?       @map("subscription_id") @db.Uuid
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  // Garde d'unicité au niveau base (BIL-02, docs/audit/BILLING-AUDIT.md) : au
  // plus une Invoice par Payment, même en cas de régression applicative future
  // (BIL-01 protège déjà le chemin webhook, ceci est une défense en
  // profondeur structurelle, pas la seule garantie).
  paymentId          String?       @unique @map("payment_id") @db.Uuid
  payment            Payment?      @relation("InvoicePayment", fields: [paymentId], references: [id])
  // Formatée à la génération (ex: "INV-<8 premiers caractères enterpriseId>-000123"),
  // construite à partir d'InvoiceCounter (Phase 5) — jamais un simple
  // auto-increment global, voir docs/PROMPT-MAITRE-SAAS.md Phase 3 §"numérotation
  // par tenant, sans trou, résistante à la concurrence".
  number             String        @unique
  // amount = amountExcludingTax + vatAmount (TTC). Aucune arithmétique en
  // virgule flottante (CLAUDE.md §7) : vatRateBasisPoints=1800 => 18.00%.
  amount             Int
  amountExcludingTax Int           @map("amount_excluding_tax")
  vatAmount          Int           @map("vat_amount")
  vatRateBasisPoints Int           @map("vat_rate_basis_points")
  legalMentions      String        @map("legal_mentions")
  status             InvoiceStatus @default(DRAFT)
  issuedAt           DateTime?     @map("issued_at")
  dueAt              DateTime?     @map("due_at")
  paidAt             DateTime?     @map("paid_at")
  pdfUrl             String?       @map("pdf_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  payments Payment[]

  @@index([enterpriseId])
  @@map("invoices")
}

// Compteur atomique par entreprise (Phase 5) : incrémenté via
// `INSERT ... ON CONFLICT (enterprise_id) DO UPDATE ... RETURNING` dans la
// même transaction que la création de l'Invoice — jamais un COUNT(*), qui ne
// résiste pas à la concurrence et laisserait des trous après un rollback.
model InvoiceCounter {
  enterpriseId String     @id @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  lastNumber   Int        @default(0) @map("last_number")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("invoice_counters")
}

// Progression de l'assistant d'onboarding post-inscription
// (docs/SPECIFICATIONS-SAAS.md §23). Les étapes 1-4 du wizard sont déjà
// couvertes par le provisioning (Phase 6) — currentStep démarre donc à 5.
model OnboardingState {
  enterpriseId String     @id @map("enterprise_id") @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  currentStep  Int        @default(5) @map("current_step")
  completedAt  DateTime?  @map("completed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("onboarding_states")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit, paramètres, notifications
// ─────────────────────────────────────────────────────────────────────────

// Append-only : aucune mise à jour ni suppression au niveau applicatif
// (docs/CLAUDE.md §6). enterpriseId/userId nullables pour les actions
// purement plateforme (ex: Super Admin modifiant un paramètre global).
model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  user         User?       @relation(fields: [userId], references: [id])
  enterpriseId String?     @map("enterprise_id") @db.Uuid
  enterprise   Enterprise? @relation(fields: [enterpriseId], references: [id])
  action       AuditAction
  resource     String
  resourceId   String?     @map("resource_id")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([enterpriseId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// scope=PLATFORM => enterpriseId NULL ; scope=ENTERPRISE => enterpriseId requis
// (invariant applicatif, comme pour User.isSuperAdmin).
model Setting {
  id              String       @id @default(uuid()) @db.Uuid
  scope           SettingScope
  enterpriseId    String?      @map("enterprise_id") @db.Uuid
  enterprise      Enterprise?  @relation(fields: [enterpriseId], references: [id])
  key             String
  value           Json
  updatedByUserId String?      @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime     @updatedAt @map("updated_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@unique([scope, enterpriseId, key])
  @@map("settings")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String?             @map("user_id") @db.Uuid
  user         User?               @relation(fields: [userId], references: [id])
  enterpriseId String?             @map("enterprise_id") @db.Uuid
  enterprise   Enterprise?         @relation(fields: [enterpriseId], references: [id])
  type         NotificationType
  channel      NotificationChannel
  title        String
  body         String
  readAt       DateTime?           @map("read_at")
  sentAt       DateTime?           @map("sent_at")
  metadata     Json?
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([userId])
  @@index([enterpriseId])
  @@map("notifications")
}
