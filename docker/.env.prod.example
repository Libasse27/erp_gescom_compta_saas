# Copier en docker/.env.prod (jamais commité — voir .gitignore) et remplacer
# chaque "change-me" par une vraie valeur secrète générée
# (ex: openssl rand -base64 32). Utilisé par docker-compose.prod.yml.

# --- Postgres (rôle superuser applicatif, PAS le rôle RLS erp_app_tenant) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp_saas_prod

# --- apps/api ---
# Rôle superuser applicatif — réservé aux migrations (`prisma migrate
# deploy`, lancé une fois via scripts/prod-post-deploy.sh). N'est plus la
# connexion runtime de l'API depuis la correction de MT-01 (voir
# docs/audit/MULTI-TENANT-AUDIT.md) : ne jamais l'injecter dans le conteneur
# `api` en fonctionnement normal.
DATABASE_URL="postgresql://erp:change-me@postgres:5432/erp_saas_prod?schema=public"
# Rôle identité non-superuser/non-propriétaire, BYPASSRLS (docs/adr/0008-...,
# migration 20260816120000_add_identity_role). Le mot de passe créé par
# cette migration est un placeholder de dev ("erp_identity_dev_password") —
# DOIT être remplacé en prod via scripts/prod-post-deploy.sh
# (IDENTITY_ROLE_PASSWORD) avant le premier démarrage réel de l'API. La
# valeur ci-dessous doit correspondre exactement au mot de passe fourni à ce
# script.
IDENTITY_DATABASE_URL="postgresql://erp_app_identity:change-me@postgres:5432/erp_saas_prod?schema=public"
IDENTITY_ROLE_PASSWORD=change-me
# Rôle RLS (docs/adr/0008-...). Le mot de passe créé par la migration
# 20260809113836_add_tenant_role_and_rls est un placeholder de dev
# ("erp_tenant_dev_password") — DOIT être remplacé en prod via
# scripts/prod-post-deploy.sh (TENANT_ROLE_PASSWORD) avant le premier
# démarrage réel de l'API. La valeur ci-dessous doit correspondre exactement
# au mot de passe fourni à ce script.
TENANT_DATABASE_URL="postgresql://erp_app_tenant:change-me@postgres:5432/erp_saas_prod?schema=public"
TENANT_ROLE_PASSWORD=change-me

JWT_ACCESS_SECRET=change-me-min-32-chars-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MFA_ENCRYPTION_KEY=change-me-min-32-chars-random-value

PAYMENT_WEBHOOK_SECRET_WAVE=change-me
PAYMENT_WEBHOOK_SECRET_ORANGE_MONEY=change-me
PAYMENT_WEBHOOK_SECRET_FREE_MONEY=change-me
PAYMENT_WEBHOOK_SECRET_STRIPE=change-me
PAYMENT_WEBHOOK_SECRET_CARD=change-me
PAYMENT_GRACE_PERIOD_DAYS=7
PAYMENT_WEBHOOK_REPLAY_TOLERANCE_SECONDS=300

# Liste blanche stricte (CLAUDE.md §6), jamais "*" — doit correspondre
# exactement à WEB_DOMAIN ci-dessous (Phase 10.6).
CORS_ALLOWED_ORIGINS="https://app.change-me.example"

# --- apps/web ---
# Inlinée au build (NEXT_PUBLIC_*) — doit correspondre exactement à
# API_DOMAIN ci-dessous (Phase 10.6).
NEXT_PUBLIC_API_URL="https://api.change-me.example"

# --- Caddy (Phase 10.6, docs/adr/0017-caddy-reverse-proxy-https.md) ---
# Domaines réels une fois le DNS du VPS connu — doivent rester synchronisés
# avec CORS_ALLOWED_ORIGINS/NEXT_PUBLIC_API_URL ci-dessus (pas
# d'interpolation automatique entre ces valeurs, à la main).
API_DOMAIN=api.change-me.example
WEB_DOMAIN=app.change-me.example
# Notifications Let's Encrypt (expiration proche, problèmes de
# renouvellement) — jamais utilisé pour autre chose.
ACME_EMAIL=change-me@example.com

# --- Monitoring (P-08, docs/audit/PRODUCTION-READINESS.md) ---
# Optionnel : désactivé si absent/vide (apps/api/src/instrument.ts,
# apps/web/src/instrumentation.ts). Voir docs/deployment/MONITORING.md pour
# créer un compte Sentry gratuit et obtenir ce DSN.
# SENTRY_DSN=https://change-me@o0.ingest.sentry.io/0

# --- Limites de ressources (P-04, docs/audit/PRODUCTION-READINESS.md) ---
# Optionnel : valeurs par défaut déjà définies dans docker-compose.prod.yml,
# à décommenter/ajuster une fois le VPS cible connu (RAM/CPU disponibles).
# POSTGRES_MEM_LIMIT=1024m
# POSTGRES_CPU_LIMIT=1.0
# API_MEM_LIMIT=512m
# API_CPU_LIMIT=1.0
# WEB_MEM_LIMIT=256m
# WEB_CPU_LIMIT=0.5
# CADDY_MEM_LIMIT=128m
# CADDY_CPU_LIMIT=0.25

# --- Copie hors-hôte des sauvegardes (écart Phase 10.4, comblé plus tard) ---
# scripts/backup-offsite-sync.sh. Clé PUBLIQUE age uniquement (sûr sur le
# VPS) — générée une fois, hors du VPS, via `age-keygen -o cle.txt` (la
# ligne "# public key: age1..." de sa sortie va ici ; la clé privée reste
# hors du VPS, fournie uniquement à scripts/backup-offsite-fetch.sh via
# AGE_IDENTITY_FILE lors d'une restauration réelle).
BACKUP_AGE_RECIPIENT=age1change-me-generate-with-age-keygen
# N'importe quel stockage S3-compatible (Scaleway, OVH, Backblaze B2...) —
# pas de fournisseur imposé, voir docs/deployment/BACKUPS.md.
S3_ENDPOINT=https://s3.change-me.example
S3_BUCKET=change-me-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
