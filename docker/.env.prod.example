# Copier en docker/.env.prod (jamais commité — voir .gitignore) et remplacer
# chaque "change-me" par une vraie valeur secrète générée
# (ex: openssl rand -base64 32). Utilisé par docker-compose.prod.yml.

# --- Postgres (rôle superuser applicatif, PAS le rôle RLS erp_app_tenant) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp_saas_prod

# --- apps/api ---
# Rôle superuser applicatif (migrations, connexion d'identité hors RLS —
# docs/adr/0008-...).
DATABASE_URL="postgresql://erp:change-me@postgres:5432/erp_saas_prod?schema=public"
# Rôle RLS (docs/adr/0008-...). Le mot de passe créé par la migration
# 20260809113836_add_tenant_role_and_rls est un placeholder de dev
# ("erp_tenant_dev_password") — DOIT être remplacé en prod via
# scripts/prod-post-deploy.sh (TENANT_ROLE_PASSWORD) avant le premier
# démarrage réel de l'API. La valeur ci-dessous doit correspondre exactement
# au mot de passe fourni à ce script.
TENANT_DATABASE_URL="postgresql://erp_app_tenant:change-me@postgres:5432/erp_saas_prod?schema=public"
TENANT_ROLE_PASSWORD=change-me

JWT_ACCESS_SECRET=change-me-min-32-chars-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MFA_ENCRYPTION_KEY=change-me-min-32-chars-random-value

PAYMENT_WEBHOOK_SECRET_WAVE=change-me
PAYMENT_WEBHOOK_SECRET_ORANGE_MONEY=change-me
PAYMENT_WEBHOOK_SECRET_FREE_MONEY=change-me
PAYMENT_WEBHOOK_SECRET_STRIPE=change-me
PAYMENT_WEBHOOK_SECRET_CARD=change-me
PAYMENT_GRACE_PERIOD_DAYS=7

# Liste blanche stricte (CLAUDE.md §6), jamais "*" — domaine(s) réel(s) de
# apps/web une fois connus (Phase 10.6).
CORS_ALLOWED_ORIGINS="https://app.change-me.example"

# --- apps/web ---
# Inlinée au build (NEXT_PUBLIC_*) — domaine réel de l'API une fois connu.
NEXT_PUBLIC_API_URL="https://api.change-me.example"
